# Copy to .env and adjust. No secrets are needed: the data source is public.

# Docker Compose: host ports and the trained model directory mounted into the API.
DXB_API_PORT=58000
DXB_UI_PORT=58001
DXB_MODEL_DIR_HOST=./artifacts/model

# Pipeline locations (defaults shown).
# DXB_DATA_DIR=./data
# DXB_ARTIFACTS_DIR=./artifacts
# DXB_MODEL_DIR=./artifacts/model
# DXB_REPORTS_DIR=./reports

# MLflow: a local file store under ./mlruns by default.
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Streamlit page run outside Docker: where to find the API.
# DXB_API_URL=http://127.0.0.1:8000
